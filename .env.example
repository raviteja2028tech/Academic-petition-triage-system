# Copy to .env (never commit .env). Placeholders only - no credentials belong here.

# --- service wiring (container-internal defaults work with docker compose) ---
REDIS_URL=redis://redis:6379/0
DB_PATH=/data/triage.sqlite3
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=regulations
CORPUS_DIR=/app/corpus
VERIFIED_PASSAGES_FILE=/app/corpus/verified_passages.json
API_BASE_URL=http://api:8000

# --- processing mode: "agents" (default, Phase 3) or "placeholder" (plumbing tests only; makes no determination) ---
AGENT_MODE=agents
PLACEHOLDER_DELAY_SECONDS=2
PROMPTS_DIR=/app/prompts

# --- agent bounds ---
MAX_RESEARCH_STEPS=8
MAX_TOOL_CALLS=10
# Hosted LLMs with a tokens-per-minute cap (e.g. 8000 TPM) need a bigger budget: one full run uses ~15-25k tokens, so
# it can take 2-4 minutes. The RQ job timeout follows it automatically (budget + 60 s).
MAX_RUN_SECONDS=450
LLM_RATE_LIMIT_MAX_ATTEMPTS=8
MAX_VERIFY_RETRIES=2
LLM_TIMEOUT_SECONDS=30

# --- local embeddings (open question A-3 in SPEC.md: D4 says no model identifiers in the repo;
#     this is the one local, non-secret embedding model id needed for a working first `docker compose up`) ---
EMBED_MODEL=all-MiniLM-L6-v2
HF_HOME=/hf_cache

# --- LLM provider (OpenAI-compatible chat API). Leave blank here; set in your private .env only.
#     Without these the agents escalate every petition with reason `llm_unavailable` (no fake answers). ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- optional fallback provider (used only if the primary fails / its circuit breaker is open) ---
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=

# --- reliability (Phase 4) ---
LLM_MAX_ATTEMPTS=3
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=30
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# --- cost estimation (Phase 5): USD per 1000 tokens for YOUR provider/model. Blank = cost is reported as "unknown". ---
PRICE_PROMPT_PER_1K=
PRICE_COMPLETION_PER_1K=
GUARDRAILS_ENABLED=true

# --- observability (Phase 6) ---
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
