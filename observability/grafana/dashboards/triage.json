   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum(rate(runs_total{status=\"failed\"}[2m])) / clamp_min(sum(rate(runs_total[2m])), 1e-9)",
     "legendFormat": "failed share",
     "refId": "A"
    }
   ]
  },
